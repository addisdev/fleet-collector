{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // "node" because vite.config.ts reads process.env. Without it the
    // dashboard typechecks only when the collector's node_modules happen to
    // be installed one directory up, which is a build that works until
    // somebody builds the dashboard on its own.
    "types": ["vite/client", "node"],
    "verbatimModuleSyntax": true
  },
  "include": ["src", "vite.config.ts"]
}
