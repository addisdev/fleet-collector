<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.addisdev.fleet-collector</string>

  <!-- The fleet-host variant: a 2016 MacBook Pro (Monterey, Intel) that does
       nothing but host the collector. Node lives in ~/.local rather than
       /opt/homebrew because this machine has no Homebrew and no Xcode command
       line tools — the collector needs neither (better-sqlite3 installs from
       a prebuild), and keeping it sudo-free means the whole stack can be
       rebuilt over SSH without anyone at the keyboard. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/elsie/.local/node/bin/node</string>
    <string>/Users/elsie/fleet-collector/node_modules/tsx/dist/cli.mjs</string>
    <string>src/server.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/elsie/fleet-collector</string>

  <!-- The devices long-poll this service; a crash that goes unnoticed strands
       every runner. KeepAlive revives it however it died. Stop it deliberately
       with `launchctl bootout`, never by killing the process. -->
  <key>KeepAlive</key>
  <true/>

  <key>RunAtLoad</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <!-- Absolute paths: the server falls back to path.resolve("data"), so a
       wrong cwd would silently create a second, empty fleet.db and the whole
       fleet history would look erased. Port 8788 because 8787 is taken on the
       workstation by another project's dashboard. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/elsie/.local/node/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>FLEET_DATA_DIR</key>
    <string>/Users/elsie/fleet-collector/data</string>
    <key>FLEET_ARTIFACT_DIR</key>
    <string>/Users/elsie/fleet-collector/artifacts/store</string>
    <key>FLEET_PORT</key>
    <string>8788</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/elsie/Library/Logs/fleet-collector.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/elsie/Library/Logs/fleet-collector.log</string>
</dict>
</plist>
