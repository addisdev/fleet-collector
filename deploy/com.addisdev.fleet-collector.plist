<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.addisdev.fleet-collector</string>

  <!-- Invoked the same way `npm start` invokes it, minus npm: tsx's CLI, run by
       an absolute node. A LaunchAgent inherits no login PATH, so nothing here
       may rely on a shell resolving a command name.

       The placeholders below are filled in by deploy/install-agent.sh. They are
       not a nicety: launchd does not expand `~`, and a plist carrying someone
       else's home directory fails by silently doing nothing. -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__FLEET_HOME__/node_modules/tsx/dist/cli.mjs</string>
    <string>src/server.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__FLEET_HOME__</string>

  <!-- The whole point: the fleet's devices long-poll this service, so a crash
       that leaves it down strands every runner until someone notices. Plain
       KeepAlive (not SuccessfulExit) means launchd revives it however it died.
       To stop it deliberately, `launchctl bootout` the job — do not kill it,
       launchd will just start it again. -->
  <key>KeepAlive</key>
  <true/>

  <key>RunAtLoad</key>
  <true/>

  <!-- Ten seconds between respawns. If the collector is crash-looping (port
       already taken by a stray `npm start`, corrupt DB), this keeps it from
       spinning, and the gaps show up plainly in the log. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <!-- Absolute, not left to WorkingDirectory: the server falls back to
       path.resolve("data"), so a wrong cwd would silently create a second,
       empty fleet.db and the fleet's whole history would look erased. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODE_BIN_DIR__:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>FLEET_DATA_DIR</key>
    <string>__FLEET_HOME__/data</string>
    <key>FLEET_ARTIFACT_DIR</key>
    <string>__FLEET_HOME__/artifacts/store</string>
    <!-- 8788: 8787 was taken by another project's dev dashboard on this Mac,
         and a KeepAlive collector that can't bind just respawns forever while
         every fleet client talks to the wrong service. -->
    <key>FLEET_PORT</key>
    <string>8788</string>

    <!-- Guards the dashboard's mutating endpoints (cancel, retry, forget a
         device, artifact GC, pool power). A speed bump, not authentication:
         POST /jobs stays open so CI and curl keep working, and anyone on the
         LAN can still enqueue. What it stops is a stray tab or a misfired
         script deleting something. Generate one per host and keep it out of
         git -- this file is a template, the real value lives only in the
         installed copy under ~/Library/LaunchAgents:
             openssl rand -base64 24 | tr -d '/+=' | cut -c1-32
    <key>FLEET_DASH_TOKEN</key>
    <string>generate-your-own</string>
    -->
  </dict>

  <!-- launchd does not rotate these; the collector logs a line per request, so
       check the size occasionally. -->
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/fleet-collector.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/fleet-collector.log</string>
</dict>
</plist>
